 	dev_info(dev,
-		 "debug_regs=1: read-only EC PWM register dump in debugfs %s/dcr\n",
-		 N5_DRIVER_NAME);
+		 "debug_regs=1: read-only EC register dumps in debugfs %s/dcr and %s/ecram\n",
+		 N5_DRIVER_NAME, N5_DRIVER_NAME);
