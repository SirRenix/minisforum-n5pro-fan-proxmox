@@ -119,6 +121,21 @@
 #define N5_I2EC_PWM_BASE        0x1800
 #define N5_I2EC_PWM_LEN         16
 
+/*
+ * Optional read-only debugfs view of ACPI EC RAM 0x00-0xff through the
+ * driver's own EC read transaction (n5_ec_read_locked(), command 0x80 on
+ * 0x62/0x66, as for the temperatures). Each byte is one lock hold with its
+ * own access budget (N5_ACCESS_BUDGET_MS). A byte is started only while at
+ * least N5_ECRAM_BYTE_US (three status waits plus the longest resync sleep)
+ * of the dump budget N5_ECRAM_BUDGET_MS is left, so a started transaction
+ * is never cut by the dump budget. The address range is a compile-time
+ * constant; there is no EC RAM write (0x81).
+ */
+#define N5_EC_RAM_SIZE          256
+#define N5_EC_RAM_ROW           16
+#define N5_ECRAM_BUDGET_MS      2000
+#define N5_ECRAM_BYTE_US        (3 * N5_WAIT_TIMEOUT_US + 2 * N5_RESYNC_US)
+
 static bool force;
 module_param(force, bool, 0444);
 MODULE_PARM_DESC(force,
@@ -132,7 +149,7 @@
 static bool debug_regs;
 module_param(debug_regs, bool, 0444);
 MODULE_PARM_DESC(debug_regs,
-		 "Read-only debugfs dump of EC PWM registers I2EC 0x1800-0x180f (validation only; off: no debugfs, no Super-I/O access)");
+		 "Read-only debugfs dumps dcr (EC PWM registers I2EC 0x1800-0x180f) and ecram (EC RAM 0x00-0xff) (validation only; off: no debugfs, no Super-I/O access, no EC RAM dump)");
 
