@@ -153,6 +170,8 @@
 	bool pwm_unknown[N5_PWM_CHANNELS];
 	/* Set under lock once teardown/shutdown started: no more port I/O. */
 	bool dead;
+	/* Set (WRITE_ONCE) before debugfs removal: running dumps stop. */
+	bool stopping;
 	bool write_enabled;
 	/* End of the time budget of the current access (under lock). */
 	ktime_t deadline;
@@ -479,11 +498,97 @@
 DEFINE_SHOW_ATTRIBUTE(n5_dcr);
 
 /*
- * debug_regs=1: create <debugfs>/minisforum_n5_it5571/dcr (0400). Only on a
- * matched board with the measured DMI sys_vendor: every read writes the
- * Super-I/O index and the I2EC address registers, which must not happen on
- * unidentified hardware (force=1). data->debugfs stays NULL when nothing
- * was created.
+ * One EC RAM byte: the temperature read transaction under data->lock, with
+ * the per-access budget. It is started only while at least
+ * N5_ECRAM_BYTE_US of the dump budget is left; otherwise the dump ends
+ * before any port access (no EC command was sent, so the message is not an
+ * EC timeout). Teardown (stopping) and .shutdown (dead) end the dump with
+ * -ENODEV, a fatal signal with -EINTR, also while waiting for the lock.
+ */
+static int n5_ecram_read_byte(struct n5_data *data, u8 address,
+			      ktime_t dump_end, u8 *value)
+{
+	int ret;
+
+	if (fatal_signal_pending(current))
+		return -EINTR;
+	ret = mutex_lock_killable(&data->lock);
+	if (ret)
+		return ret;
+	if (data->dead || READ_ONCE(data->stopping)) {
+		ret = -ENODEV;
+		goto out;
+	}
+	if (ktime_us_delta(dump_end, ktime_get()) < N5_ECRAM_BYTE_US) {
+		dev_warn_ratelimited(data->dev,
+				     "ecram dump aborted before EC RAM 0x%02x: less than %d us of the %d ms dump budget left\n",
+				     address, N5_ECRAM_BYTE_US,
+				     N5_ECRAM_BUDGET_MS);
+		ret = -ETIMEDOUT;
+		goto out;
+	}
+	n5_access_begin(data);
+	ret = n5_ec_read_locked(data, address, value);
+out:
+	mutex_unlock(&data->lock);
+	return ret;
+}
+
+/*
+ * All or nothing: the first failed byte ends the dump and read() returns
+ * its error (-ETIMEDOUT, -ENODEV on teardown or after shutdown, -EINTR on a
+ * fatal signal); nothing is printed then. The lock is dropped between
+ * bytes, so hwmon accesses interleave and the dump is not one instant.
+ * Format: 16 rows of "%02x:" and 16 bytes, parsable like an ec_probe dump.
+ */
+static int n5_ecram_show(struct seq_file *s, void *unused)
+{
+	struct n5_data *data = s->private;
+	u8 ram[N5_EC_RAM_SIZE];
+	ktime_t dump_end;
+	int i, ret;
+
+	dump_end = ktime_add_ms(ktime_get(), N5_ECRAM_BUDGET_MS);
+	for (i = 0; i < N5_EC_RAM_SIZE; i++) {
+		ret = n5_ecram_read_byte(data, i, dump_end, &ram[i]);
+		if (ret)
+			return ret;
+	}
+
+	for (i = 0; i < N5_EC_RAM_SIZE; i += N5_EC_RAM_ROW)
+		seq_printf(s, "%02x: %*ph\n", i, N5_EC_RAM_ROW, &ram[i]);
+	return 0;
+}
+
+/*
+ * Not seekable: seq_file would run a whole new dump for lseek() or for a
+ * pread() at an offset other than the current one. Both give -ESPIPE;
+ * sequential partial reads are served from the first dump's buffer.
+ */
+static int n5_ecram_open(struct inode *inode, struct file *file)
+{
+	int ret;
+
+	ret = nonseekable_open(inode, file);
+	if (ret)
+		return ret;
+	return single_open(file, n5_ecram_show, inode->i_private);
+}
+
+static const struct file_operations n5_ecram_fops = {
+	.owner = THIS_MODULE,
+	.open = n5_ecram_open,
+	.read = seq_read,
+	.release = single_release,
+};
+
+/*
+ * debug_regs=1: create <debugfs>/minisforum_n5_it5571/dcr and ecram (both
+ * 0400). Only on a matched board with the measured DMI sys_vendor: every
+ * dcr read writes the Super-I/O index and the I2EC address registers, every
+ * ecram read sends 256 EC read commands; neither may happen on unidentified
+ * hardware (force=1). data->debugfs stays NULL when not both files were
+ * created.
  */
 static void n5_debugfs_init(struct device *dev, struct n5_data *data,
 			    const struct n5_board_profile *profile)
@@ -510,16 +615,19 @@
