---
--- a/driver-prototype/minisforum_n5_it5571.c
+++ b/driver-prototype/minisforum_n5_it5571.c
@@ -870,13 +870,18 @@
  * Hand every channel this module touched back (n5_handback_locked(): CPU,
  * SSD, HDD to EC automatic mode, PCIe to 255) and refuse all later
  * hwmon/debugfs accesses (-ENODEV). Runs as a devres action after the hwmon
- * device is gone and before the port regions are released.
+ * device is gone and before the port regions are released. After the
+ * .shutdown hook (dead already set) it does nothing.
  */
 static void n5_restore(struct n5_data *data)
 {
 	int i, ret;
 
 	mutex_lock(&data->lock);
+	if (data->dead) {
+		mutex_unlock(&data->lock);
+		return;
+	}
 	data->dead = true;
 	for (i = 0; i < N5_PWM_CHANNELS; i++) {
 		if (!data->pwm_touched[i])
@@ -1015,11 +1020,61 @@
 	return 0;
 }
 
+/*
+ * Reboot/poweroff, only for channels this module touched: CPU and SSD go
+ * back to EC automatic mode, which regulates them. HDD and PCIe are set to
+ * 255 instead. PCIe keeps its last duty after the auto command. HDD, as a
+ * precaution: the EC regulates it to a target RPM from EC 0x06 (ambient),
+ * not disk temperature (derived from EC firmware, befunde M5). Either may
+ * undercut the regulator's fail-safe for the next boot if the module is not
+ * loaded again. PCIe handed back with pwm4_enable=2 stays touched (0004)
+ * and gets 255 here again. A failed step leaves the channel as it is (no
+ * fallback to the auto command, which could lower the duty). Sets the dead
+ * flag: later accesses return -ENODEV and the devres restore does nothing.
+ */
+static void n5_shutdown(struct platform_device *pdev)
+{
+	static const bool full_speed[N5_PWM_CHANNELS] = {
+		false, false, true, true
+	};
+	struct n5_data *data = platform_get_drvdata(pdev);
+	int i, ret;
+
+	if (!data)
+		return;
+
+	mutex_lock(&data->lock);
+	if (data->dead) {
+		mutex_unlock(&data->lock);
+		return;
+	}
+	data->dead = true;
+	for (i = 0; i < N5_PWM_CHANNELS; i++) {
+		if (!data->pwm_touched[i])
+			continue;
+		n5_access_begin(data);
+		if (full_speed[i])
+			ret = n5_set_pwm_locked(data, i, 255);
+		else
+			ret = n5_set_auto_locked(data, i);
+		if (ret) {
+			dev_warn(data->dev,
+				 "shutdown: PWM channel %d not set to %s (%d)\n",
+				 i + 1, full_speed[i] ? "255" : "EC automatic mode",
+				 ret);
+			continue;
+		}
+		data->pwm_touched[i] = false;
+	}
+	mutex_unlock(&data->lock);
+}
+
 static struct platform_driver n5_driver = {
 	.driver = {
 		.name = N5_DRIVER_NAME,
 	},
 	.probe = n5_probe,
+	.shutdown = n5_shutdown,
 };
 
 static int __init n5_init(void)
