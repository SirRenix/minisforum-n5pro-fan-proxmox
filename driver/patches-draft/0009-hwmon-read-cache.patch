---
--- a/driver-prototype/minisforum_n5_it5571.c
+++ b/driver-prototype/minisforum_n5_it5571.c
@@ -43,6 +43,7 @@
 #include <linux/io.h>
 #include <linux/iopoll.h>
 #include <linux/ioport.h>
+#include <linux/jiffies.h>
 #include <linux/ktime.h>
 #include <linux/minmax.h>
 #include <linux/module.h>
@@ -138,6 +139,21 @@
 #define N5_ECRAM_BUDGET_MS      2000
 #define N5_ECRAM_BYTE_US        (3 * N5_WAIT_TIMEOUT_US + 2 * N5_RESYNC_US)
 
+/*
+ * Sensor read cache. temp*_input and fan*_input are world-readable, and an
+ * uncached read did live EC/PMC2 I/O under data->lock, so any local user
+ * could keep the lock and the EC busy in a loop. Each input keeps the
+ * result of its last refresh; for N5_CACHE_MS after that a read is served
+ * from the cache under data->lock without port I/O. A refresh covers one
+ * input (one temperature byte or one tachometer channel), i.e. exactly the
+ * EC access of an uncached read with the same access budget, so it holds
+ * the lock no longer than before. A refresh that timed out (-ETIMEDOUT, EC
+ * not answering) is cached as that error for the same time, so a reader
+ * flood cannot keep the lock busy with one timed-out access per read while
+ * the EC hangs. Other errors (-EAGAIN, torn tachometer read) are not cached.
+ */
+#define N5_CACHE_MS             1000
+
 static bool force;
 module_param(force, bool, 0444);
 MODULE_PARM_DESC(force,
@@ -180,6 +196,18 @@
 	/* A wait on this interface timed out; resync before the next use. */
 	bool resync_ec;
 	bool resync_pmc2;
+	/*
+	 * Sensor cache (N5_CACHE_MS), under lock; *_updated in jiffies,
+	 * *_err 0 or the cached -ETIMEDOUT of the last refresh.
+	 */
+	u8 temp_raw[N5_TEMP_CHANNELS];
+	int temp_err[N5_TEMP_CHANNELS];
+	unsigned long temp_updated[N5_TEMP_CHANNELS];
+	bool temp_valid[N5_TEMP_CHANNELS];
+	long fan_rpm[N5_TACH_CHANNELS];
+	int fan_err[N5_TACH_CHANNELS];
+	unsigned long fan_updated[N5_TACH_CHANNELS];
+	bool fan_valid[N5_TACH_CHANNELS];
 };
 
 static struct platform_device *n5_pdev;
@@ -203,6 +231,19 @@
 	"PCIe Fan (no tach)",
 };
 
+/* Caller holds data->lock. A cached sensor result younger than N5_CACHE_MS. */
+static bool n5_cache_fresh(bool valid, unsigned long updated)
+{
+	return valid &&
+	       time_before(jiffies, updated + msecs_to_jiffies(N5_CACHE_MS));
+}
+
+/* Refresh results that are cached: a value or an EC timeout. */
+static bool n5_cache_result(int ret)
+{
+	return !ret || ret == -ETIMEDOUT;
+}
+
 /* Caller holds data->lock. Starts the time budget of one sysfs access. */
 static void n5_access_begin(struct n5_data *data)
 {
@@ -698,13 +739,24 @@
 	case hwmon_temp:
 		if (attr != hwmon_temp_input || channel >= N5_TEMP_CHANNELS)
 			return -EOPNOTSUPP;
-		mutex_lock(&data->lock);
+		/* World-readable: a waiting reader can be killed. */
+		if (mutex_lock_killable(&data->lock))
+			return -EINTR;
 		if (data->dead) {
 			ret = -ENODEV;
+		} else if (n5_cache_fresh(data->temp_valid[channel],
+					  data->temp_updated[channel])) {
+			ret = data->temp_err[channel];
+			temp = data->temp_raw[channel];
 		} else {
 			n5_access_begin(data);
 			ret = n5_ec_read_locked(data, n5_temp_reg[channel],
 						&temp);
+			data->temp_valid[channel] = n5_cache_result(ret);
+			if (!ret)
+				data->temp_raw[channel] = temp;
+			data->temp_err[channel] = ret;
+			data->temp_updated[channel] = jiffies;
 		}
 		mutex_unlock(&data->lock);
 		if (ret)
@@ -717,12 +769,24 @@
 	case hwmon_fan:
 		if (channel >= N5_TACH_CHANNELS || attr != hwmon_fan_input)
 			return -EOPNOTSUPP;
-		mutex_lock(&data->lock);
+		/* World-readable: a waiting reader can be killed. */
+		if (mutex_lock_killable(&data->lock))
+			return -EINTR;
 		if (data->dead) {
 			ret = -ENODEV;
+		} else if (n5_cache_fresh(data->fan_valid[channel],
+					  data->fan_updated[channel])) {
+			ret = data->fan_err[channel];
+			if (!ret)
+				*value = data->fan_rpm[channel];
 		} else {
 			n5_access_begin(data);
 			ret = n5_read_fan_locked(data, channel, value);
+			data->fan_valid[channel] = n5_cache_result(ret);
+			if (!ret)
+				data->fan_rpm[channel] = *value;
+			data->fan_err[channel] = ret;
+			data->fan_updated[channel] = jiffies;
 		}
 		mutex_unlock(&data->lock);
 		/* 0xffff: no valid tachometer reading (0 = fan stopped). */
