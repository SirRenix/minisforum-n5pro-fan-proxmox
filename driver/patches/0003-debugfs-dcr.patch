+/* Caller holds data->lock and the muxed region N5_SIO_INDEX/N5_SIO_DATA. */
+static void n5_i2ec_set_address(u16 address)
+{
+	outb(N5_SIO_D2ADR, N5_SIO_INDEX);
+	outb(N5_I2EC_ADDR_HIGH, N5_SIO_DATA);
+	outb(N5_SIO_D2DAT, N5_SIO_INDEX);
+	outb(address >> 8, N5_SIO_DATA);
+	outb(N5_SIO_D2ADR, N5_SIO_INDEX);
+	outb(N5_I2EC_ADDR_LOW, N5_SIO_DATA);
+	outb(N5_SIO_D2DAT, N5_SIO_INDEX);
+	outb(address & 0xff, N5_SIO_DATA);
+}
+
+/* Caller holds data->lock and the muxed region N5_SIO_INDEX/N5_SIO_DATA. */
+static u8 n5_i2ec_read(u16 address)
+{
+	n5_i2ec_set_address(address);
+	outb(N5_SIO_D2ADR, N5_SIO_INDEX);
+	outb(N5_I2EC_DATA, N5_SIO_DATA);
+	outb(N5_SIO_D2DAT, N5_SIO_INDEX);
+	return inb(N5_SIO_DATA);
+}
+
+static int n5_dcr_show(struct seq_file *s, void *unused)
+{
+	struct n5_data *data = s->private;
+	u8 regs[N5_I2EC_PWM_LEN];
+	int i;
+
+	mutex_lock(&data->lock);
+	if (!request_muxed_region(N5_SIO_INDEX, 2, N5_DRIVER_NAME)) {
+		mutex_unlock(&data->lock);
+		return -EBUSY;
+	}
+	for (i = 0; i < N5_I2EC_PWM_LEN; i++)
+		regs[i] = n5_i2ec_read(N5_I2EC_PWM_BASE + i);
+	release_region(N5_SIO_INDEX, 2);
+	mutex_unlock(&data->lock);
+
+	/* Same format as research-tools/n5_i2ec_read 0x1800 16. */
+	seq_printf(s, "%04x:", N5_I2EC_PWM_BASE);
+	for (i = 0; i < N5_I2EC_PWM_LEN; i++)
+		seq_printf(s, " %02x", regs[i]);
+	seq_putc(s, '\n');
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(n5_dcr);
+
+/*
+ * debug_regs=1: create <debugfs>/minisforum_n5_it5571/dcr (0400). Only on a
+ * matched board with the measured DMI sys_vendor: every read writes the
+ * Super-I/O index and the I2EC address registers, which must not happen on
+ * unidentified hardware (force=1). data->debugfs stays NULL when nothing
+ * was created.
+ */
+static void n5_debugfs_init(struct device *dev, struct n5_data *data,
+			    const struct n5_board_profile *profile)
+{
+	struct dentry *dir, *file;
+
+	if (!debug_regs)
+		return;
+	if (!profile) {
+		dev_warn(dev, "debug_regs=1 ignored: unknown system (force=1)\n");
+		return;
+	}
+	if (!dmi_match(DMI_SYS_VENDOR, N5_SYS_VENDOR)) {
+		dev_warn(dev, "debug_regs=1 ignored: DMI sys_vendor is not \"%s\"\n",
+			 N5_SYS_VENDOR);
+		return;
+	}
+
+	dir = debugfs_create_dir(N5_DRIVER_NAME, NULL);
+	if (IS_ERR(dir)) {
+		dev_warn(dev, "debug_regs=1: debugfs directory not created (%pe)\n",
+			 dir);
+		return;
+	}
+	/* Read-only (0400); no write interface of any kind. */
+	file = debugfs_create_file("dcr", 0400, dir, data, &n5_dcr_fops);
+	if (IS_ERR(file)) {
+		debugfs_remove_recursive(dir);
+		dev_warn(dev, "debug_regs=1: debugfs file dcr not created (%pe)\n",
+			 file);
+		return;
+	}
+	data->debugfs = dir;
+	dev_info(dev,
+		 "debug_regs=1: read-only EC PWM register dump in debugfs %s/dcr\n",
+		 N5_DRIVER_NAME);
+}
