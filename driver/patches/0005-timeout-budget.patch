+static int n5_wait_status(struct n5_data *data, unsigned short status_port,
+			  u8 mask, bool set, u8 cmd, u8 arg)
+{
+	s64 left_us = ktime_us_delta(data->deadline, ktime_get());
+	u64 timeout_us = N5_WAIT_TIMEOUT_US;
+	bool budget = false;
