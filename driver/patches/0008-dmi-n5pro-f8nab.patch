--- a/driver-prototype/minisforum_n5_it5571.c
+++ b/driver-prototype/minisforum_n5_it5571.c
@@ -30,7 +30,8 @@
  * a board in the downstream write allowlist (N5 Pro/F8NAA). Every other
  * system, force=1 included, is read-only: no PWM writes, but sensor reads
  * still send EC read commands. debug_regs=1 takes effect only on a matched
- * board with that vendor.
+ * board with that vendor. N5 PRO/F8NAB binds by product and board name
+ * (strings from community reports, vendor not measured) and is read-only.
  */
 
 #include <linux/bitops.h>
@@ -792,6 +793,16 @@
 	.write_allowlist = true,
 };
 
+/*
+ * N5 PRO on board F8NAB: product/board strings reported by two users,
+ * not measured here. Not in the write allowlist, so it is read-only even
+ * with experimental_write=1 until raw data from such a board exists.
+ */
+static struct n5_board_profile n5_pro_f8nab = {
+	.name = "Minisforum N5 Pro / F8NAB",
+	.validated = false,
+};
+
 static struct n5_board_profile n5_air_f8nab = {
 	.name = "Minisforum N5 Air / F8NAB",
 	.validated = false,
@@ -821,6 +832,15 @@
 		.driver_data = &n5_pro_f8naa,
 	},
