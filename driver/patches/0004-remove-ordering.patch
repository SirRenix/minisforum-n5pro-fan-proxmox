+/*
+ * Hand every channel this module touched back (n5_handback_locked(): CPU,
+ * SSD, HDD to EC automatic mode, PCIe to 255) and refuse all later
+ * hwmon/debugfs accesses (-ENODEV). Runs as a devres action after the hwmon
+ * device is gone and before the port regions are released.
+ */
+static void n5_restore(struct n5_data *data)
+{
+	int i, ret;
+
+	mutex_lock(&data->lock);
+	data->dead = true;
+	for (i = 0; i < N5_PWM_CHANNELS; i++) {
+		if (!data->pwm_touched[i])
+			continue;
+		ret = n5_handback_locked(i);
+		if (ret) {
+			/* Kept for a later bind of this module (pwm_unknown). */
+			set_bit(i, &n5_unrestored);
+			dev_warn(data->dev,
+				 "failed to restore PWM channel %d to %s (%d)\n",
+				 i + 1, i == N5_PWM_PCIE ? "255" :
+				 "EC automatic mode", ret);
+			continue;
+		}
+		clear_bit(i, &n5_unrestored);
+		data->pwm_touched[i] = false;
+		data->pwm_unknown[i] = false;
+		data->pwm_enable[i] = 2;
+	}
+	mutex_unlock(&data->lock);
+}
+
+static void n5_teardown(void *arg)
+{
+	n5_restore(arg);
+}
+
+static void n5_debugfs_remove(void *arg)
+{
+	/* Waits for running readers of the dcr file. */
+	debugfs_remove_recursive(arg);
+}
