 MODULE_DEVICE_TABLE(dmi, n5_dmi_table);
 
+static const char n5_block_no_optin[] = "experimental_write=0";
+
+/*
+ * Returns NULL if PWM writes may be enabled, otherwise the reason why not.
+ * A force-loaded unknown system is always read-only.
+ */
+static const char *n5_write_block_reason(const struct n5_board_profile *profile)
+{
+	if (!profile)
+		return "unknown system, force=1 binds read-only";
+	if (!dmi_match(DMI_SYS_VENDOR, N5_SYS_VENDOR))
+		return "DMI sys_vendor is not \"" N5_SYS_VENDOR "\"";
+	if (profile->validated)
+		return NULL;
+	if (!profile->write_allowlist)
+		return "board is not in the downstream write allowlist";
+	if (!experimental_write)
+		return n5_block_no_optin;
+	return NULL;
+}
