#!/bin/bash
# journalctl stub: prints the fake kernel log; honours --since @EPOCH
# (lines in $F8A_ROOT/kmsg are "EPOCH<TAB>text")
set -eu
since=0
while [ $# -gt 0 ]; do
    case "$1" in
        --since) shift; since=${1#@} ;;
        --since=*) since=${1#--since=}; since=${since#@} ;;
    esac
    shift
done
case "$since" in ''|*[!0-9]*) echo "journalctl stub: only --since @EPOCH is simulated" >&2; exit 1 ;; esac
if [ -e "$F8A_ROOT/fake/journal-broken" ]; then
    echo "Failed to open journal" >&2
    exit 1
fi
awk -F '\t' -v s="$since" -v h="$(uname -n)" '$1 >= s { print "@" $1 " " h " kernel: " $2 }' "$F8A_ROOT/kmsg"
