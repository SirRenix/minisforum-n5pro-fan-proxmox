#!/usr/bin/env bash
# n5-fand-failsafe — ExecStopPost der Unit. Laeuft nach JEDEM Ende des Reglers,
# auch nach SIGKILL, Watchdog-Kill oder Absturz, wo der Stop-Handler des
# Daemons nicht mehr dran kam. Setzt einen definierten, sicheren Zustand:
#   CPU/SSD -> EC-Automatik (funktioniert nachweislich)
#   HDD     -> HDD_STOP_PWM manuell (EC regelt den Kanal nach Write nicht mehr)
# Idempotent; scheitert nie laut (Exit 0), meldet aber ins Journal.
set -u
CONF="${N5_FAND_CONF:-/etc/n5-fand.conf}"
HDD_STOP_PWM=140
if [[ -r "$CONF" ]]; then
    v="$(sed -n 's/^HDD_STOP_PWM=\([0-9]\+\).*/\1/p' "$CONF" | head -1)"
    [[ -n "$v" ]] && (( v >= 80 && v <= 255 )) && HDD_STOP_PWM="$v"
fi
FAN=""
for h in /sys/class/hwmon/hwmon*; do
    [[ -r "$h/name" && "$(<"$h/name")" == "minisforum_n5_it5571" ]] && FAN="$h"
done
if [[ -z "$FAN" ]]; then
    echo "n5-fand-failsafe: kein hwmon des Moduls — EC hat die Kontrolle (Modul entladen?)"
    exit 0
fi
r=""
echo 2 > "$FAN/pwm1_enable" 2>/dev/null && r+=" pwm1=auto" || r+=" pwm1=FEHLER"
echo 2 > "$FAN/pwm2_enable" 2>/dev/null && r+=" pwm2=auto" || r+=" pwm2=FEHLER"
if { [[ "$(<"$FAN/pwm3_enable")" == "1" ]] || echo 1 > "$FAN/pwm3_enable"; } 2>/dev/null \
   && echo "$HDD_STOP_PWM" > "$FAN/pwm3" 2>/dev/null; then
    r+=" pwm3=$HDD_STOP_PWM"
else
    r+=" pwm3=FEHLER"
fi
echo "n5-fand-failsafe: sicherer Zustand gesetzt (SERVICE_RESULT=${SERVICE_RESULT:-?} EXIT=${EXIT_STATUS:-?}):$r"
rm -f /run/n5-fand/state
exit 0
